.top-row { display:flex; justify-content:space-between; align-items:flex-start; }
.settings-btn { margin:0; background:#1c2025; color:#f5f7f8; border-radius:20rpx; font-size:24rpx; }
.hero { display:flex; justify-content:space-between; align-items:center; padding:38rpx 30rpx; }
.hero-number { font-size:76rpx; font-weight:800; margin-top:12rpx; }
.hero-number text, .metric text { color:#8f99a4; font-size:24rpx; font-weight:500; }
.hero-sub { margin-top:10rpx; color:#8f99a4; font-size:22rpx; }
.percent { width:120rpx; height:120rpx; border-radius:60rpx; border:12rpx solid #b9ff63; display:flex; align-items:center; justify-content:center; font-size:28rpx; font-weight:800; }
.metric-grid { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; }
.metric-card { margin:0; }
.metric-card.wide { grid-column:1 / 3; }
.chart { height:210rpx; display:flex; align-items:flex-end; justify-content:space-between; gap:10rpx; }
.bar-item { flex:1; height:190rpx; display:flex; flex-direction:column; justify-content:flex-end; align-items:center; gap:10rpx; }
.bar { width:34rpx; min-height:6rpx; border-radius:12rpx 12rpx 4rpx 4rpx; background:#b9ff63; }
.bar-label { color:#8f99a4; font-size:18rpx; }
.recent-row { display:flex; justify-content:space-between; align-items:center; }
.recent-name { font-weight:700; margin-bottom:8rpx; }
.recent-meta { color:#8f99a4; white-space:pre-line; text-align:right; font-size:22rpx; line-height:1.5; }
