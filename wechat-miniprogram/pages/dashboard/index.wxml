<view class="container">
  <view class="top-row">
    <view>
      <view class="eyebrow">TODAY</view>
      <view class="title">LiftLog</view>
    </view>
    <button class="settings-btn" bindtap="goSettings">设置</button>
  </view>

  <view class="card hero" bindtap="goFood">
    <view>
      <view class="muted">今日饮食摄入</view>
      <view class="hero-number">{{todayFood.calories}}<text> kcal</text></view>
      <view class="hero-sub">目标 {{todayFood.goal}} kcal · {{todayFood.status}} {{todayFood.remaining}} kcal</view>
    </view>
    <view class="percent">{{caloriePercent}}%</view>
  </view>

  <view class="section-title">今日训练</view>
  <view class="metric-grid">
    <view class="card metric-card"><view class="muted">训练组数</view><view class="metric">{{todayTraining.sets}}</view></view>
    <view class="card metric-card"><view class="muted">总次数</view><view class="metric">{{todayTraining.reps}}</view></view>
    <view class="card metric-card wide"><view class="muted">训练容量</view><view class="metric">{{todayTraining.volume}}<text> kg</text></view></view>
  </view>

  <view class="section-title">最近 7 天训练容量</view>
  <view class="card chart">
    <view class="bar-item" wx:for="{{weekly}}" wx:key="date">
      <view class="bar" style="height: {{item.height}}rpx"></view>
      <view class="bar-label">{{item.label}}</view>
    </view>
  </view>

  <view class="section-title">最近动作</view>
  <view wx:if="{{recent.length}}">
    <view class="card recent-row" wx:for="{{recent}}" wx:key="id">
      <view>
        <view class="recent-name">{{item.name}}</view>
        <view class="muted">{{item.date}}</view>
      </view>
      <view class="recent-meta">{{item.sets}}组 · {{item.reps}}次\n{{item.volume}} kg</view>
    </view>
  </view>
  <view class="empty" wx:else bindtap="goLog">还没有训练记录，点这里开始第一组。</view>
</view>
